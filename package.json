{
  "name": "att-trace-viewer",
  "displayName": "ATT Trace Viewer",
  "description": "View ROCm Advanced Thread Trace (ATT) in a VS Code webview timeline",
  "version": "0.0.50",
  "publisher": "jfactory07",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jfactory07/vscode-att-viewer.git"
  },
  "homepage": "https://github.com/jfactory07/vscode-att-viewer#readme",
  "bugs": {
    "url": "https://github.com/jfactory07/vscode-att-viewer/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": [
    "ROCm",
    "AMD",
    "GPU",
    "ATT",
    "thread trace",
    "profiling",
    "timeline",
    "trace viewer"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onCustomEditor:attViewer.attEditor",
    "onCommand:attViewer.openAtt",
    "onCommand:attViewer.openAttFromUri"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "attViewer.attEditor",
        "displayName": "ATT Trace Viewer",
        "selector": [{ "filenamePattern": "*.att" }],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "attViewer.openAtt",
        "title": "ATT Viewer: Open ATT Trace"
      },
      {
        "command": "attViewer.openAttFromUri",
        "title": "ATT Viewer: Open ATT Trace (from file)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "attViewer.openAttFromUri",
          "when": "resourceExtname == .att",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "ATT Viewer",
      "properties": {
        "attViewer.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python executable to run the offline ATT decoder"
        },
        "attViewer.maxEvents": {
          "type": "number",
          "default": 0,
          "description": "Cap decoded instruction events (0 = all, with automatic safety cap on very large traces). Use this to speed up large traces."
        },
        "attViewer.rocprofilerSdkPath": {
          "type": "string",
          "default": "/opt/rocm/lib/librocprofiler-sdk.so",
          "description": "Path to librocprofiler-sdk.so used for ATT decoding"
        },
        "attViewer.llvmObjdumpPath": {
          "type": "string",
          "default": "/opt/rocm/llvm/bin/llvm-objdump",
          "description": "Path to llvm-objdump used for disassembly in the source panel"
        }
      }
    }
  }
}

